# RAGX API image (full profile: ES + Neo4j + MinIO + PG + Redis + Grafana).
#
#   docker build -f Dockerfile.full -t ragx:full .
#   docker compose -f deploy/compose/full.yml up -d
#
# Runtime is configured exclusively through RAGX_* env vars (02-core.md §2.4);
# the full defaults are wired by deploy/compose/full.yml.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY ragx ./ragx

# Full extra covers ES, Qdrant, Neo4j, MinIO, Redis, embed-st, deepdoc, mineru.
# Skip torch-heavy extras at install time if the deployment doesn't need them.
RUN pip install --no-cache-dir ".[full]" \
    || pip install --no-cache-dir \
        ".[sqlite,graph-nx,redis,es,neo4j,minio,embed-st]"

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "ragx.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
