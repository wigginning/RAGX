  "panels": [
    {
      "type": "timeseries",
      "title": "Query latency (P50/P95/P99) by stage",
      "id": 1,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(ragx_query_latency_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "p50 {{stage}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ragx_query_latency_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "p95 {{stage}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ragx_query_latency_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "p99 {{stage}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Query total by mode + status",
      "id": 2,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum by (mode, status) (rate(ragx_query_total[5m]))",
          "legendFormat": "{{mode}}/{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
